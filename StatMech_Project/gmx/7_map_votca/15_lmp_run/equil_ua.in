
# General
units real
atom_style full
dimension 3
newton on
boundary p p p

read_data ../12_lmp_skeleton/ua_skeleton.data

special_bonds lj 0.0 0.0 1.0

pair_style table linear 1000
bond_style table linear 1000
angle_style table linear 1000
dihedral_style table linear 1000

include ../14_lmp_data/table_coeffs.in

# Settings
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
run_style verlet

# Output
dump 1 all custom 10000 compress.lammpstrj id xu yu zu vx vy vz ix iy iz
dump_modify 1 sort id
thermo_style custom step vol temp press pe ke etotal evdwl ecoul ebond eangle edihed eimp density
thermo 10000

# minimize first
min_style cg
minimize 1.0e-4 1.0e-6 100000 10000000
min_style fire
minimize 1.0e-4 1.0e-6 100000 10000000

write_data after_minimize.lmps

timestep 0.05
fix 22 all nve/limit 0.01
run 1000
unfix 22

write_data after_nve.lmps

timestep 0.1

# 1
fix 1 all nvt temp 600 600 $(100.0*dt)
velocity all create 600 58447419 dist gaussian mom yes rot yes
run $(50000.0/dt)
unfix 1

# 2
fix 1 all nvt temp 308 308 $(100.0*dt)
velocity all scale 308
run $(50000.0/dt)
unfix 1

# 3 0.02*Pmax
fix 1 all npt temp 308 308 $(100.0*dt) iso 1000 1000 $(1000.0*dt)
velocity all scale 308
run $(50000.0/dt)
unfix 1

# 4
fix 1 all nvt temp 600 600 $(100.0*dt)
velocity all scale 600
run $(50000.0/dt)
unfix 1

# 5
fix 1 all nvt temp 308 308 $(100.0*dt)
velocity all scale 308
run $(100000.0/dt)
unfix 1

# 6 0.6*Pmax
fix 1 all npt temp 308 308 $(100.0*dt) iso 30000 30000 $(1000.0*dt)
velocity all scale 308
run $(50000.0/dt)
unfix 1

# 7
fix 1 all nvt temp 600 600 $(100.0*dt)
velocity all scale 600
run $(50000.0/dt)
unfix 1

# 8
fix 1 all nvt temp 308 308 $(100.0*dt)
velocity all scale 308
run $(100000.0/dt)
unfix 1

# 9 Pmax=50000
fix 1 all npt temp 308 308 $(100.0*dt) iso 50000 50000 $(1000.0*dt)
velocity all scale 308
run $(50000.0/dt)
unfix 1

# 10
fix 1 all nvt temp 600 600 $(100.0*dt)
velocity all scale 600
run $(5000.0/dt)
unfix 1

# 11
fix 1 all nvt temp 308 308 $(100.0*dt)
velocity all scale 308
run $(5000.0/dt)
unfix 1

# 12 0.5*Pmax
fix 1 all npt temp 308 308 $(100.0*dt) iso 25000 25000 $(1000.0*dt)
velocity all scale 308
run $(10000.0/dt)
unfix 1

# 13
fix 1 all nvt temp 600 600 $(100.0*dt)
velocity all scale 600
run $(5000.0/dt)
unfix 1

# 14
fix 1 all nvt temp 308 308 $(100.0*dt)
velocity all scale 308
run $(5000.0/dt)
unfix 1

# 15 0.1*Pmax
fix 1 all npt temp 308 308 $(100.0*dt) iso 5000 5000 $(1000.0*dt)
velocity all scale 308
run $(10000.0/dt)
unfix 1

# 16
fix 1 all nvt temp 600 600 $(100.0*dt)
velocity all scale 600
run $(5000.0/dt)
unfix 1

# 17
fix 1 all nvt temp 308 308 $(100.0*dt)
velocity all scale 308
run $(5000.0/dt)
unfix 1

# 18 0.01*Pmax
fix 1 all npt temp 308 308 $(100.0*dt) iso 500 500 $(1000.0*dt)
velocity all scale 308
run $(10000.0/dt)
unfix 1

# 19
fix 1 all nvt temp 600 600 $(100.0*dt)
velocity all scale 600
run $(5000.0/dt)
unfix 1

# 20
fix 1 all nvt temp 308 308 $(100.0*dt)
velocity all scale 308
run $(10000.0/dt)
unfix 1

# 21 Pfinal=1 bar
fix 1 all npt temp 308 308 $(100.0*dt) iso 1 1 $(1000.0*dt)
velocity all scale 308
run $(800000.0/dt)
unfix 1

write_data equilibrated_ua.lmps
