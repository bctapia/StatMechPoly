
# General
units real
atom_style full
dimension 3
newton on
boundary p p p

# Styles
pair_style lj/charmmfsw/coul/long 9.0 10.0 10.0
pair_modify mix arithmetic
kspace_style pppm 1.0e-5
bond_style       harmonic
angle_style      harmonic
dihedral_style   fourier
improper_style   cvff
special_bonds    amber

# System definition
read_data equilibrated.lmps

# Settings
dielectric 1.0
neighbor 2.0 bin
neigh_modify delay 0 every 1 check yes
timestep 1
run_style verlet

dump 1 all custom 1000 compress_01.lammpstrj id type xu yu zu vx vy vz ix iy iz
dump_modify 1 sort id
thermo_style custom step vol temp press etotal evdwl ecoul ebond eangle edihed eimp density
thermo 1000

# types: (1,Lc5) (2,Lca) (3,c3) (4,c5) (5,ca) (6,cp) (7, cy) (8, ha) (9, hc)

# RDFs for X-X X-Y Y-Y, 200 bins, sample every 1000 steps, avg 100 samples, write every 100000 steps
compute myRDF all rdf 200 4 4 4 5 5 5
fix rdfout all ave/time 1000 200 2000000 c_myRDF[*] file rdf.dat mode vector

# Bonded param distributions, labeled by type, dumped every 1000 steps
# Bonded param distributions, labeled by type, dumped every 1000 steps

compute blval all bond/local dist
compute bltype all property/local btype
dump bldump all local 10000 bonds.dump c_bltype c_blval

compute angval all angle/local theta
compute angtype all property/local atype
dump angdump all local 10000 angles.dump c_angtype c_angval

compute dihval all dihedral/local phi
compute dihtype all property/local dtype
dump dihdump all local 10000 dihedrals.dump c_dihtype c_dihval

fix 1 all nvt temp 308 308 $(100.0*dt)
velocity all scale 308
run 10000000
unfix 1

write_data post_nvt.lmps
